# Public site URL (used for metadata and, later, hosted pass links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Studio, Phase 3). Not needed for the public playground.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cospel

# Apple Wallet signing (Phase 2). Paths to PEM files readable by the server only.
# Never prefix these with NEXT_PUBLIC_: they must not reach the browser.
PASS_TYPE_IDENTIFIER=pass.com.example.loyalty
APPLE_TEAM_IDENTIFIER=ABCDE12345
PASS_SIGNER_CERT=./secrets/pass.pem
PASS_SIGNER_KEY=./secrets/pass.key
PASS_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT=./secrets/wwdr.pem

# 32-byte key (base64) for encrypting signing secrets stored in the database.
# Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Business contact form: POST target (Slack/Zapier/CRM webhook). In development
# leads are logged to the server console when unset.
CONTACT_WEBHOOK_URL=
